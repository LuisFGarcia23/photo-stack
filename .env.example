# See https://docs.immich.app/install/environment-variables

# Immich media storage (external drive)
UPLOAD_LOCATION=
# Postgres data — must be on local disk, not a network share
DB_DATA_LOCATION=./postgres
TZ=America/Chicago
# Pin to a specific version like "v2.1.0" if desired
IMMICH_VERSION=v3
# Only A-Za-z0-9
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# icloudpd
ICLOUD_LOCATION=
APPLE_ID=

# Second iCloud account
ICLOUD_LOCATION_2=
APPLE_ID_2=
